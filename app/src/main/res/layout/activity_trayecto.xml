<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Encabezado -->

    <TextView
        android:id="@+id/lblTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registro de trayecto"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="20dp" />

    <!-- Nombre del trayecto -->
    <TextView
        android:id="@+id/lblTitulo2"
        android:layout_width="176dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Nombre del trayecto"
        android:textAlignment="center"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etTrayecto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del trayecto (ejemplo: casa)"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <!-- Botón para iniciar la captura -->
    <TextView
        android:id="@+id/tvAviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="#FFABAB"
        android:text="no cierres la app mientras se capturan las coordenadas, Si la cieras, el registro se detiene"
        android:textAlignment="center"
        android:textColor="#FF0000"
        android:textColorLink="#673AB7"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCaptura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar Captura GPS"
        android:layout_marginBottom="24dp" />

    <!-- Coordenadas obtenidas -->
    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado del servidor: Esperando..."
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvUltimaCoordenada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Coordenadas: --, --"
        android:textSize="16sp"
        android:layout_marginBottom="10dp" />

    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Respuesta del servidor -->

</LinearLayout>
